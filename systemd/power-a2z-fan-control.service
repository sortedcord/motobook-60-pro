[Unit]
Description=Privileged fan-control broker for power-a2z

[Service]
ExecStart=/usr/bin/python3 /usr/local/lib/power-a2z/fan_control_service.py
Environment=FAN_CONTROL_UID=1000
RuntimeDirectory=power-a2z
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
ProtectSystem=strict
ProtectHome=yes
NoNewPrivileges=yes
ReadWritePaths=/run/lock
Restart=on-failure
