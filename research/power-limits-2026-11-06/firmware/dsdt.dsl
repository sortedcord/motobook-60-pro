                    Notify (WMIU, 0xD0) // Hardware-Specific
                }

                Method (_Q7E, 0, NotSerialized)  // _Qxx: EC Query, xx=0x00-0xFF
                {
                    P80H = 0x7E
                    LSK2 = 0x10
                    Notify (WMIU, 0xD0) // Hardware-Specific
                }

                Method (_Q7A, 0, NotSerialized)  // _Qxx: EC Query, xx=0x00-0xFF
                {
                    ADBG ("Q7A Event")
                    P8XH (Zero, 0x7A)
                    If ((SAFG == Zero))
                    {
                        LSK2 = 0x2A
                        Notify (WMIU, 0xD0) // Hardware-Specific
                    }
                }

