                If ((Arg0 == ToUUID ("d2a8c3e8-4b69-4f00-82bd-fe8607803aa7") /* Unknown UUID */))
                {
                    If ((WFTY == One))
                    {
                        While (One)
                        {
                            If ((Arg2 == Zero))
                            {
                                Return (0x19)
                            }
                            ElseIf ((Arg2 == One))
