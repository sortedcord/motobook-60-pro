                    {
                        FDEL = PRTD /* \_SB_.PC00.RP08.PXSX.IFUN.PRTD */
                    }
                    ElseIf ((PRTT == 0x02))
                    {
                        PDEL = PRTD /* \_SB_.PC00.RP08.PXSX.IFUN.PRTD */
                    }
                    ElseIf ((PRTT == 0x03))
                    {
                        VDEL = PRTD /* \_SB_.PC00.RP08.PXSX.IFUN.PRTD */
                    }
                    Else
                    {
