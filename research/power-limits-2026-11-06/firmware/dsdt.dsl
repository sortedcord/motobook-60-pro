                        While (One)
                        {
                            If ((Arg2 == Zero))
                            {
                                Return (0x19)
                            }
                            ElseIf ((Arg2 == 0x03))
                            {
                                Return (Zero)
                            }
                            ElseIf ((Arg2 == 0x04))
                            {
