                        ElseIf ((ToInteger (Arg2) == 0x24))
                        {
                            Return (Zero)
                        }
                        ElseIf ((ToInteger (Arg2) == 0x25))
                        {
                            Return (Zero)
                        }
                        ElseIf ((ToInteger (Arg2) == 0x26))
                        {
                            Return (0x24)
                        }
                        Else
                        {
                            Return (Zero)
                        }
                    }
                    ElseIf ((Arg1 == 0x02))
                    {
                        If ((ToInteger (Arg2) == One))
                        {
                            ^^PC00.LPCB.Q_EC.ECWT (One, RefOf (^^PC00.LPCB.Q_EC.MCST))
                            ADBG ("The MIC is ON")
                            Return (Zero)
                        }
                        ElseIf ((ToInteger (Arg2) == 0x02))
                        {
                            ^^PC00.LPCB.Q_EC.ECWT (Zero, RefOf (^^PC00.LPCB.Q_EC.MCST))
                            ADBG ("The MIC is OFF")
                            Return (Zero)
                        }
                        Else
                        {
                            ADBG ("The MIC mute action fail")
                            Return (One)
                        }
                    }
                    ElseIf ((Arg1 == 0x03))
                    {
                        MLKB = Arg2
                        If ((ToInteger (VALU) == SMKL))
                        {
                            ^^PC00.LPCB.Q_EC.IDID = ToInteger (KBID)
                            Return (SUCC) /* \_SB_.SUCC */
                        }
                    }
                }

                Method (_WED, 1, NotSerialized)  // _Wxx: Wake Event, xx=0x00-0xFF
                {
                    If ((Arg0 == 0xD0))
                    {
                        Return (^^PC00.LPCB.Q_EC.LSK2) /* \_SB_.PC00.LPCB.Q_EC.LSK2 */
                    }
                }

