#!/bin/sh
set -eu
if [ "$(id -u)" -ne 0 ]; then
    echo "Run: sudo $0" >&2
    exit 1
fi
project_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
install -d -o root -g root -m 0755 /usr/local/lib/power-a2z
install -o root -g root -m 0755 "$project_dir/motobook-fan-control" /usr/local/lib/power-a2z/motobook-fan-control
install -o root -g root -m 0644 "$project_dir/fan_control_service.py" /usr/local/lib/power-a2z/fan_control_service.py
install -o root -g root -m 0644 "$project_dir/systemd/power-a2z-fan-control.socket" /etc/systemd/system/power-a2z-fan-control.socket
install -o root -g root -m 0644 "$project_dir/systemd/power-a2z-fan-control.service" /etc/systemd/system/power-a2z-fan-control.service
systemctl daemon-reload
systemctl enable --now power-a2z-fan-control.socket
if systemctl is-active --quiet power-a2z-fan-control.service; then
    systemctl restart power-a2z-fan-control.service
fi
