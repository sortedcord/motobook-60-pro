#!/bin/sh
set -eu
if [ "$(id -u)" -ne 0 ]; then
    echo "Run: sudo $0" >&2
    exit 1
fi
project_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
install -d -o root -g root -m 0755 /usr/local/lib/power-a2z
install -o root -g root -m 0644 "$project_dir/power_sampler.py" /usr/local/lib/power-a2z/power_sampler.py
install -o root -g root -m 0644 "$project_dir/systemd/power-a2z-power.service" /etc/systemd/system/power-a2z-power.service
install -o root -g root -m 0644 "$project_dir/systemd/power-a2z-power.timer" /etc/systemd/system/power-a2z-power.timer
systemctl daemon-reload
systemctl enable --now power-a2z-power.timer
systemctl start power-a2z-power.service
