#!/usr/bin/env python3
"""Read the Motobook 60 14IAH10 fan RPM through its firmware getter."""
import argparse
import datetime as dt
import fcntl
import json
import os
from pathlib import Path
import re
import subprocess
import sys
import tempfile


def read_rpm():
    if os.geteuid() != 0:
        raise RuntimeError(f'Run: sudo {Path(__file__).resolve()}')
    if (Path('/sys/class/dmi/id/sys_vendor').read_text().strip(),
            Path('/sys/class/dmi/id/product_name').read_text().strip()) != ('MOTOROLA', '83NY'):
        raise RuntimeError('This firmware query is configured for the MOTOROLA 83NY only.')

    subprocess.run(['/usr/bin/modprobe', 'acpi_call'], check=True, timeout=4)
    with open('/run/lock/motobook-fan-speed.lock', 'w') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        interface = Path('/proc/acpi/call')
        # WMAE method 0x11 (Get), feature 0x04030001: current fan speed.
        interface.write_text(r'\_SB.GZFD.WMAE 0 17 b01000304')
        result = interface.read_text().rstrip('\x00')
        if not result.startswith('{'):
            raise RuntimeError('Fan query failed: ' + result)
        values = re.findall(r'0x([0-9a-fA-F]{1,2})\b', result)
        if len(values) != 4:
            raise RuntimeError('Unexpected fan response: ' + result)
        rpm = int.from_bytes(bytes(int(v, 16) for v in values), 'little')
        if rpm > 20000:
            raise RuntimeError('Implausible fan response: ' + result)
        return rpm


def publish(path, sample):
    """Replace the cache atomically; readers never see a partial JSON object."""
    path = Path(path)
    temporary = None
    try:
        with tempfile.NamedTemporaryFile(mode='w', dir=path.parent, delete=False) as stream:
            temporary = Path(stream.name)
            json.dump(sample, stream, allow_nan=False)
            stream.write('\n')
            stream.flush()
            os.fchmod(stream.fileno(), 0o644)
        os.replace(temporary, path)
    finally:
        if temporary is not None:
            temporary.unlink(missing_ok=True)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--output', type=Path, help='Atomically publish a JSON sample to this file')
    args = parser.parse_args()
    sample = {'rpm': None, 'status': 'error'}
    try:
        sample.update(rpm=read_rpm(), status='ok')
    except (OSError, RuntimeError, subprocess.SubprocessError) as error:
        sample['error'] = str(error)
    sample['timestamp'] = dt.datetime.now(dt.timezone.utc).isoformat()
    if args.output:
        publish(args.output, sample)
    if sample['status'] != 'ok':
        print(sample['error'], file=sys.stderr)
        return 1
    print(f"CPU fan: {sample['rpm']:,} RPM")
    return 0


if __name__ == '__main__':
    sys.exit(main())
